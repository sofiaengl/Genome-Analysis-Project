# Load libraries
library(DESeq2)
library(apeglm)
library(pheatmap)
library(ggplot2)
library(dplyr)
library(tidyr)
library(ggrepel)

# Putting in the counts file
BH <- read.delim("bh_counts.txt", header = FALSE, row.names = 1)

# Read Serum counts
Serum <- read.delim("serum_counts.txt", header = FALSE, row.names = 1)
  
# Remove HTSeq technical rows
BH <- BH[!grepl("^__", rownames(BH)), ]
Serum <- Serum[!grepl("^__", rownames(Serum)), ]

counts <- cbind(BH, Serum)

# Add sample names
colnames(counts) <- c(
    "BH_ERR1797972", "BH_ERR1797973", "BH_ERR1797974",
    "serum_ERR1797969", "serum_ERR1797970", "serum_ERR1797971")
  
# Sample metadata
sample_info <- data.frame(
  row.names = colnames(counts),
  condition = factor(c("BH", "BH", "BH", "serum", "serum", "serum")))

# Set reference level
sample_info$condition <- relevel(sample_info$condition, ref = "BH")
  
# Build DESeq dataset
dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = sample_info,
  design = ~ condition)
  
# Pre-filter low counts
dds <- dds[rowSums(counts(dds)) >= 10, ]
  
# Run DESeq2
dds <- DESeq(dds)
 
# Extract results
res <- results(dds, contrast = c("condition", "serum", "BH"))
res <- res[order(res$padj), ]
  
# Shrink log fold changes
res_shrunk <- lfcShrink(
  dds,
  coef = "condition_serum_vs_BH",
  type = "apeglm",
  lfcThreshold = 1)
 
# MA plot
plotMA(res_shrunk, ylim = c(-4, 4))
abline(h = c(-1, 1), col = "grey", lwd = 2)

# Significant genes
sig <- subset(res, padj < 0.001 & abs(log2FoldChange) > 1)
  
sig <- sig[order(sig$padj), ]
  
# VST transformation
vsd <- vst(dds, blind = FALSE)
  
# Sample annotation
df <- as.data.frame(colData(dds))

# PCA
plotPCA(vsd, intgroup = "condition")
 
